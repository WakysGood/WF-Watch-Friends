{
  "name": "wf-watch-friends",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../WF-Watch-Friends.apk",
    "release:ota": "node scripts/prepare-update.js ota",
    "release:apk": "node scripts/prepare-update.js apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capgo/capacitor-updater": "^8.53.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.0.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.57.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
